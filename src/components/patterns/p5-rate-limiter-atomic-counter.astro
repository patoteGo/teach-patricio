                <rect
                  x="180"
                  y="90"
                  width="100"
                  height="50"
                  rx="10"
                  fill="#211d33"
                  stroke="#8b6ff7"
                />
                <text x="230" y="119" fill="#8b6ff7" text-anchor="middle">
                  API ×N
                </text>
                <rect
                  x="430"
                  y="55"
                  width="240"
                  height="88"
                  rx="10"
                  fill="#2a0f1c"
                  stroke="#fb7185"
                />
                <text x="550" y="82" fill="#fb7185" text-anchor="middle">
                  Redis
                </text>
                <text
                  x="550"
                  y="101"
                  fill="#9ea2b8"
                  text-anchor="middle"
                  font-size="11"
                  data-pt="INCR + EXPIRE no 1º (Lua)"
                  data-en="INCR + EXPIRE on 1st (Lua)"
                >
                  INCR + EXPIRE no 1º (Lua)
                </text>
                <text
                  x="550"
                  y="118"
                  fill="#9ea2b8"
                  text-anchor="middle"
                  font-size="10"
