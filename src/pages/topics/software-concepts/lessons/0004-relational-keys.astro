---
// Migrated verbatim from public/topics/software-concepts/lessons/0004-relational-keys.html (URL unchanged: builds to 0004-relational-keys.html).
// Body is is:raw: braces/inline scripts/JSON blocks pass through untouched.
import Lesson from "../../../../layouts/Lesson.astro";
const titlePt = "Chaves relacionais — PK e FK, o 1-para-muitos";
const titleEn = "Relational keys — PK and FK, the one-to-many";
const titleFallback = "Relational keys";
const bodyClass = "lang-pt";
const viewport = "width=device-width,initial-scale=1.0";
const assets = [
	"<link rel=\"stylesheet\" href=\"../assets/style.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/dark.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/i18n.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/concepts.css\" />",
	"<script src=\"../assets/i18n.js\" defer></script>",
	"<script src=\"../assets/nav.js\" defer></script>",
	"<script src=\"../assets/reading-ui.js\" defer></script>",
	"<script src=\"../assets/concepts.js\" defer></script>",
];
const pageStyle = ".kcard {\n        padding: 16px;\n        border: 1px solid var(--line);\n        border-radius: 14px;\n        background: var(--paper-2);\n        margin: 14px 0;\n      }\n      .kcard h3 {\n        margin: 0 0 4px;\n        color: var(--violet);\n      }\n      .kbadge {\n        display: inline-block;\n        font: 700 0.62rem \"JetBrains Mono\";\n        padding: 3px 8px;\n        border-radius: 6px;\n        margin-left: 6px;\n        vertical-align: middle;\n      }\n      .kbadge.pk {\n        background: var(--teal-50);\n        color: var(--teal);\n        border: 1px solid var(--teal);\n      }\n      .kbadge.fk {\n        background: var(--amber-50);\n        color: var(--amber);\n        border: 1px solid var(--amber);\n      }\n      @keyframes fk-pulse {\n        0%,\n        100% {\n          filter: drop-shadow(0 0 0 transparent);\n        }\n        50% {\n          filter: drop-shadow(0 0 8px var(--amber));\n        }\n      }\n      .fk-link {\n        animation: fk-pulse 2.4s ease-in-out infinite;\n      }";

---
<Lesson
	titlePt={titlePt}
	titleEn={titleEn}
	titleFallback={titleFallback}
	bodyClass={bodyClass}
	viewport={viewport}
	assets={assets}
	pageStyle={pageStyle}
>
	<Fragment is:raw>
    <article class="lesson">
      <header class="hero">
        <span class="eyebrow"
          >⬡ <span data-lang="pt">Conceitos · chaves</span
          ><span data-lang="en">Concepts · keys</span></span
        >
        <h1>
          <span data-lang="pt"
            >A chave estrangeira mora no lado do “muitos”.</span
          ><span data-lang="en">The foreign key lives on the “many” side.</span>
        </h1>
        <p class="lead">
          <span data-lang="pt"
            >O erro que custou pontos na sua entrevista: você colocou a chave
            estrangeira na tabela errada. Uma regra simples resolve para
            sempre.</span
          ><span data-lang="en"
            >The mistake that cost you points in your interview: you put the
            foreign key on the wrong table. One simple rule fixes it
            forever.</span
          >
        </p>
      </header>
      <nav class="concept-nav">
        <a href="0001-sql-foundations.html">← SQL</a
        ><a href="0005-estimation.html"
          ><span data-lang="pt">Estimativa →</span
          ><span data-lang="en">Estimation →</span></a
        ><a href="../reference/software-concepts-cheatsheet.html"
          ><span data-lang="pt">Folha</span><span data-lang="en">Cheat</span></a
        >
      </nav>

      <h2 class="section">
        <span class="num">1</span
        ><span data-lang="pt">Duas chaves, dois papéis</span
        ><span data-lang="en">Two keys, two roles</span>
      </h2>
      <div class="kcard">
        <h3>
          <span data-lang="pt">Chave primária (PK)</span
          ><span data-lang="en">Primary key (PK)</span>
          <span class="kbadge pk">PK</span>
        </h3>
        <p>
          <span data-lang="pt"
            >Identifica <strong>uma única linha</strong> numa tabela. Nunca se
            repete, nunca é nula. Toda tabela tem uma.</span
          ><span data-lang="en"
            >Identifies <strong>a single row</strong> in a table. Never repeats,
            never null. Every table has one.</span
          >
        </p>
        <p>
          <code>users(id, email, name)</code>
          <span data-lang="pt">— aqui <code>id</code> é a PK.</span
          ><span data-lang="en">— here <code>id</code> is the PK.</span>
        </p>
      </div>
      <div class="kcard">
        <h3>
          <span data-lang="pt">Chave estrangeira (FK)</span
          ><span data-lang="en">Foreign key (FK)</span>
          <span class="kbadge fk">FK</span>
        </h3>
        <p>
          <span data-lang="pt"
            >Uma coluna que <strong>aponta para a PK de outra tabela</strong>.
            Diz: “esta linha pertence àquela”.</span
          ><span data-lang="en"
            >A column that <strong>points to another table's PK</strong>. It
            says: “this row belongs to that one.”</span
          >
        </p>
        <p>
          <code>orders(user_id)</code>
          <span data-lang="pt"
            >aponta para <code>users.id</code> — então <code>user_id</code> é
            FK.</span
          ><span data-lang="en"
            >points to <code>users.id</code> — so <code>user_id</code> is the
            FK.</span
          >
        </p>
      </div>

      <h2 class="section">
        <span class="num">2</span
        ><span data-lang="pt">A regra que você errou</span
        ><span data-lang="en">The rule you got wrong</span>
      </h2>
      <div class="callout key">
        <p>
          <span data-lang="pt"
            >Num relacionamento 1-para-muitos,
            <strong
              >a FK fica na tabela do “muitos” (a filha), nunca na do “um” (a
              mãe).</strong
            >
            Uma lista tem muitos itens → a FK mora em <code>item</code>, não em
            <code>todo_list</code>.</span
          ><span data-lang="en"
            >In a one-to-many relationship,
            <strong
              >the FK goes on the “many” table (the child), never the “one”
              table (the parent).</strong
            >
            A list has many items → the FK lives in <code>item</code>, not in
            <code>todo_list</code>.</span
          >
        </p>
      </div>
      <div class="scroll-x" style="margin: 18px 0">
        <svg
          viewBox="0 0 720 260"
          width="100%"
          style="min-width: 680px"
          role="img"
          aria-labelledby="fk-t"
        >
          <title
            id="fk-t"
            data-pt="todo_list (1) tem muitos item; a FK todolist_id mora em item"
            data-en="todo_list (1) has many item; the FK todolist_id lives in item"
          >
            FK lives on many side
          </title>
          <defs>
            <marker
              id="fka"
              markerWidth="9"
              markerHeight="9"
              refX="7"
              refY="3"
              orient="auto"
            >
              <path d="M0,0 L0,6 L8,3 z" fill="#fbbf24" />
            </marker>
          </defs>
          <!-- parent table -->
          <g font-family="Space Grotesk" font-size="12" font-weight="700">
            <rect
              x="40"
              y="40"
              width="230"
              height="170"
              rx="12"
              fill="var(--paper-2)"
              stroke="var(--teal)"
              stroke-width="2"
            />
            <text x="155" y="62" fill="var(--teal)" text-anchor="middle">
              todo_list
              <tspan class="kbadge pk" fill="var(--teal)">(a mãe · 1)</tspan>
            </text>
            <text x="60" y="92" fill="var(--ink)">id</text>
            <text x="200" y="92" fill="var(--teal)" text-anchor="start">
              PK
            </text>
            <text x="60" y="116" fill="var(--ink-soft)">name</text>
            <text x="60" y="140" fill="var(--ink-soft)">created_at</text>
            <text
              x="60"
              y="176"
              fill="var(--rose)"
              text-decoration="line-through"
            >
              items ❌
            </text>
          </g>
          <!-- child table -->
          <g font-family="Space Grotesk" font-size="12" font-weight="700">
            <rect
              x="450"
              y="40"
              width="240"
              height="170"
              rx="12"
              fill="var(--paper-2)"
              stroke="var(--amber)"
              stroke-width="2"
            />
            <text x="570" y="62" fill="var(--amber)" text-anchor="middle">
              item (a filha · muitos)
            </text>
            <text x="470" y="92" fill="var(--ink)">id</text>
            <text x="640" y="92" fill="var(--teal)">PK</text>
            <text x="470" y="116" fill="var(--ink)">todolist_id</text>
            <text x="640" y="116" fill="var(--amber)" class="fk-link">
              FK ✓
            </text>
            <text x="470" y="140" fill="var(--ink-soft)">name</text>
            <text x="470" y="164" fill="var(--ink-soft)">checked</text>
          </g>
          <!-- the FK arrow -->
          <path
            class="fk-link"
            d="M470 112 C400 112 380 96 270 90"
            fill="none"
            stroke="var(--amber)"
            stroke-width="2.5"
            marker-end="url(#fka)"
          />
          <text
            x="360"
            y="80"
            fill="var(--amber)"
            text-anchor="middle"
            font-family="Inter"
            font-size="11"
          >
            aponta para todo_list.id
          </text>
        </svg>
      </div>
      <div class="callout warn">
        <p>
          <span data-lang="pt"
            ><strong
              >Por que não dá pra colocar <code>items</code> na lista?</strong
            ></span
          ><span data-lang="en"
            ><strong
              >Why can't you put <code>items</code> on the list?</strong
            ></span
          >
        </p>
        <p style="margin-top: 6px">
          <span data-lang="pt"
            >Porque uma coluna guarda <strong>um valor por linha</strong>. A
            lista não tem “um item” — tem vários. Não cabe numa coluna. A FK
            resolve isso ao morar onde cada item é uma linha separada.</span
          ><span data-lang="en"
            >Because a column holds <strong>one value per row</strong>. The list
            doesn't have “one item” — it has many. That doesn't fit a column.
            The FK solves it by living where each item is its own row.</span
          >
        </p>
      </div>

      <h2 class="section">
        <span class="num">3</span
        ><span data-lang="pt">O modelo correto, escrito</span
        ><span data-lang="en">The correct model, written out</span>
      </h2>
      <div class="code-stage">
        <pre><code>todo_list (
  id          <span style="color:#5eead4">PRIMARY KEY</span>,
  name,
  created_at
)
item (
  id          <span style="color:#5eead4">PRIMARY KEY</span>,
  todolist_id <span style="color:#fbbf24">REFERENCES todo_list(id)</span>,   <span style="color:#8b88b8" data-lang="pt">-- a FK, no lado dos muitos</span><span style="color:#8b88b8" data-lang="en">-- the FK, on the 'many' side</span>
  name,
  checked     <span style="color:#8b88b8">boolean</span>
)</code></pre>
      </div>
      <p>
        <span data-lang="pt"
          >Lê-se: <strong>“cada item pertence a uma lista”</strong>. Para achar
          os itens da lista 5:
          <code>SELECT * FROM item WHERE todolist_id = 5</code>.</span
        ><span data-lang="en"
          >Read it as: <strong>“each item belongs to one list.”</strong> To find
          list 5's items:
          <code>SELECT * FROM item WHERE todolist_id = 5</code>.</span
        >
      </p>

      <h2 class="section">
        <span class="num">4</span
        ><span data-lang="pt">Confira o modelo mental</span
        ><span data-lang="en">Check the mental model</span>
      </h2>
      <div class="mcq" data-mcq>
        <p class="mcq-q">
          <span data-lang="pt"
            >Um usuário tem muitos pedidos. Onde fica a FK?</span
          ><span data-lang="en"
            >A user has many orders. Where does the FK go?</span
          >
        </p>
        <div class="mcq-opts">
          <button
            class="mcq-opt"
            data-correct="false"
            data-fb-pt="Errado: o usuário é o lado do 'um'. A FK mora no lado dos muitos."
            data-fb-en="Wrong: the user is the 'one' side. The FK lives on the 'many' side."
          >
            users.user_orders
          </button>
          <button
            class="mcq-opt"
            data-correct="true"
            data-fb-pt="Exato: orders.user_id aponta para users.id. A FK fica na tabela dos muitos (pedidos)."
            data-fb-en="Correct: orders.user_id points to users.id. The FK lives on the 'many' table (orders)."
          >
            orders.user_id
          </button>
          <button
            class="mcq-opt"
            data-correct="false"
            data-fb-pt="Não existe FK 'dos dois lados' no 1-para-muitos. Só a filha aponta para a mãe."
            data-fb-en="There's no FK 'on both sides' in a one-to-many. Only the child points to the parent."
          >
            <span data-lang="pt">em ambas as tabelas</span
            ><span data-lang="en">on both tables</span>
          </button>
        </div>
        <div class="mcq-fb" data-fb></div>
      </div>
      <div class="mcq" data-mcq>
        <p class="mcq-q">
          <span data-lang="pt"
            >Uma chave primária pode ser nula ou repetir?</span
          ><span data-lang="en">Can a primary key be null or repeat?</span>
        </p>
        <div class="mcq-opts">
          <button
            class="mcq-opt"
            data-correct="true"
            data-fb-pt="Exato: a PK é única e não-nula por definição. É o endereço da linha."
            data-fb-en="Correct: the PK is unique and non-null by definition. It's the row's address."
          >
            <span data-lang="pt">Nunca — única e não-nula</span
            ><span data-lang="en">Never — unique and non-null</span>
          </button>
          <button
            class="mcq-opt"
            data-correct="false"
            data-fb-pt="Se repetisse, duas linhas teriam o mesmo endereço — você não saberia qual buscar."
            data-fb-en="If it repeated, two rows would share an address — you couldn't tell which to fetch."
          >
            <span data-lang="pt">Pode repetir, se for único por usuário</span
            ><span data-lang="en">It can repeat, if unique per user</span>
          </button>
          <button
            class="mcq-opt"
            data-correct="false"
            data-fb-pt="Nula significa 'sem valor'; mas a PK precisa identificar a linha. Contradição."
            data-fb-en="Null means 'no value'; but the PK must identify the row. Contradiction."
          >
            <span data-lang="pt">Pode ser nula em alguns casos</span
            ><span data-lang="en">It can be null in some cases</span>
          </button>
        </div>
        <div class="mcq-fb" data-fb></div>
      </div>
      <div class="mcq" data-mcq>
        <p class="mcq-q">
          <span data-lang="pt">Na sua entrevista, o que estava errado?</span
          ><span data-lang="en">In your interview, what was wrong?</span>
        </p>
        <div class="mcq-opts">
          <button
            class="mcq-opt"
            data-correct="false"
            data-fb-pt="Não — a tabela mãe não guarda FK para os filhos. Você marcou items como FK em todo_list."
            data-fb-en="No — the parent table doesn't hold a FK to its children. You marked items as FK on todo_list."
          >
            <span data-lang="pt">Nada, estava certo</span
            ><span data-lang="en">Nothing, it was correct</span>
          </button>
          <button
            class="mcq-opt"
            data-correct="true"
            data-fb-pt="Exato: você colocou items/FK na mãe e marcou todolist_id como PK na filha. Invertido. A FK (todolist_id) pertence à filha."
            data-fb-en="Correct: you put items/FK on the parent and marked todolist_id as PK on the child. Inverted. The FK (todolist_id) belongs on the child."
          >
            <span data-lang="pt">A FK estava na tabela errada (invertida)</span
            ><span data-lang="en"
              >The FK was on the wrong table (inverted)</span
            >
          </button>
          <button
            class="mcq-opt"
            data-correct="false"
            data-fb-pt="Faltou PK, mas o erro principal foi a FK invertida."
            data-fb-en="A PK was missing, but the main error was the inverted FK."
          >
            <span data-lang="pt">Faltou uma PK</span
            ><span data-lang="en">A PK was missing</span>
          </button>
        </div>
        <div class="mcq-fb" data-fb></div>
      </div>

      <h2 class="section">
        <span class="num">5</span
        ><span data-lang="pt">A frase de entrevista</span
        ><span data-lang="en">The interview line</span>
      </h2>
      <div class="callout tip">
        <p>
          <span data-lang="pt"
            >“Cada item pertence a uma lista — é um relacionamento
            1-para-muitos, então a FK <code>todolist_id</code> mora na tabela
            <code>item</code> e referencia <code>todo_list.id</code>.” Dizer
            isso, apontando para o diagrama, fecha a questão.</span
          ><span data-lang="en"
            >“Each item belongs to one list — it's a one-to-many relationship,
            so the FK <code>todolist_id</code> lives in the
            <code>item</code> table and references <code>todo_list.id</code>.”
            Saying that while pointing at the diagram closes the question.</span
          >
        </p>
      </div>
      <div class="callout info">
        <p>
          <span data-lang="pt"
            >🗣️ <strong>Pergunte ao agente:</strong> “como fica se um item puder
            pertencer a várias listas?” (resposta: tabela de junção —
            muitos-para-muitos).</span
          ><span data-lang="en"
            >🗣️ <strong>Ask the agent:</strong> “what if an item can belong to
            several lists?” (answer: a join table — many-to-many).</span
          >
        </p>
      </div>
      <p class="cite-line">
        <span data-lang="pt">Próximo →</span><span data-lang="en">Next →</span>
        <a href="0005-estimation.html"
          ><span data-lang="pt">Estimativa e DAU</span
          ><span data-lang="en">Estimation and DAU</span></a
        >
        ·
        <a href="0001-sql-foundations.html"
          ><span data-lang="pt">rever SQL</span
          ><span data-lang="en">review SQL</span></a
        >
      </p>
    </article>
  </Fragment>
</Lesson>
