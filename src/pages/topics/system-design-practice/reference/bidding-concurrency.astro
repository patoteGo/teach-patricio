              </td>
            </tr>
            <tr>
              <td>WebSocket fan-out</td>
              <td>
                <span data-lang="pt"
                  >empurra atualizações aos watchers (batch de
                  100&nbsp;ms)</span
                ><span data-lang="en"
                  >push updates to watchers (100&nbsp;ms delta batch)</span
                >
              </td>
              <td>
                <span data-lang="pt">não</span><span data-lang="en">no</span>
              </td>
            </tr>
            <tr>
              <td>Proxy bidding</td>
              <td>
                <span data-lang="pt">resolução de auto-incremento</span
                ><span data-lang="en">auto-increment resolution</span>
              </td>
              <td>
                <span data-lang="pt">não</span><span data-lang="en">no</span>
              </td>
            </tr>
            <tr>
              <td>Postgres</td>
