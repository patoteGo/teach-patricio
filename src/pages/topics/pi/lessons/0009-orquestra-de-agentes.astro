          >
            <span data-lang="pt">O gerente</span
            ><span data-lang="en">The manager</span>
          </button>
          <button
            class="opt"
            data-correct="false"
            data-fb-pt="O barramento transporta mensagens; não cria nem decide."
            data-fb-en="The bus carries messages; it doesn’t create or decide."
