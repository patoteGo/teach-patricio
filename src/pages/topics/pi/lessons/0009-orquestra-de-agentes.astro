r: var(--amber);\n      }\n      .matcher .scene p {\n        margin: 4px 0 0;\n        color: var(--ink);\n      }\n      .matcher .opts {\n        display: grid;\n        grid-template-columns: repeat(2, 1fr);\n        gap: 8px;\n      }\n      .matcher .opts button {\n        cursor: pointer;\n        text-align: left;\n        font: inherit;\n        padding: 10px 12px;\n        border-radius: 9px;\n        border: 1.5px solid var(--line);\n        background: var(--paper-2);\n        color: var(--ink);\n        transition: all 0.14s;\n      }\n      .matcher .opts button:hover:not(:disabled) {\n        border-color: var(--violet);\n      }\n      .matcher .opts button.right {\n        background: var(--teal-50);\n        border-color: var(--teal);\n        color: var(--teal);\n      }\n      .matcher .opts button.wrong {\n        background: var(--rose-50);\n        border-color: var(--rose);\n        color: var(--rose);\n      }\n      .matcher .opts button:disabled {\n        cursor: default;\n      }\n      .matcher .fb {\n        margin-top: 12px;\n        min-height: 1.2em;\n        font-weight: 600;\n        font-size: 0.9rem;\n      }\n      .matcher .fb.ok {\n        color: var(--teal);\n      }\n      .matcher .score {\n        margin-top: 10px;\n        font: 700 0.8rem \"JetBrains Mono\";\n        color: var(--ink-soft);\n      }\n\n      @media (max-width: 720px) {\n        .patterns {\n          grid-template-columns: 1fr;\n        }\n        .matcher .opts {\n          grid-template-columns: 1fr;\n        }\n      }\n      @media print {\n        .langswitch,\n        .sim-stage,\n        .sim-log,\n        .sim-controls,\n        .matcher .opts {\n          display: none;\n        }\n        .topo {\n          overflow: visible;\n        }\n        .topo svg {\n          min-width: 0;\n        }\n      }";

