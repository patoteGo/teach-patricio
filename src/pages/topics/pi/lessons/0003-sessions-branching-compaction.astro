// Body is is:raw: braces/inline scripts/JSON blocks pass through untouched.
import Lesson from "../../../../layouts/Lesson.astro";
const titlePt = "Pi · Lição 3 — Sessões, Ramificação e Compaction";
const titleEn = "Pi · Lesson 3 — Sessions, Branching & Compaction";
const titleFallback = "Pi · Lição 3 — Sessões, Ramificação e Compaction";
const bodyClass = "lang-pt";
const viewport = "width=device-width, initial-scale=1.0";
const assets = [
	"<link rel=\"stylesheet\" href=\"../assets/style.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/dark.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/i18n.css\" />",
	"<script src=\"../assets/i18n.js\" defer></script>",
	"<script src=\"../assets/nav.js\" defer></script>",
];

---
<Lesson
	titlePt={titlePt}
	titleEn={titleEn}
	titleFallback={titleFallback}
	bodyClass={bodyClass}
	viewport={viewport}
	assets={assets}
>
	<Fragment is:raw>
    <article class="lesson">
      <!-- ===================== HERO ===================== -->
      <header class="hero">
        <span class="eyebrow"
          ><span data-lang="pt">⬡ Lição 03 · Sessões</span
          ><span data-lang="en">⬡ Lesson 03 · Sessions</span></span
        >
        <h1>
          <span data-lang="pt"
            >Um arquivo,<br />muitos ramos,<br />nada perdido.</span
          ><span data-lang="en"
            >One file,<br />many branches,<br />nothing lost.</span
          >
        </h1>
        <p class="lead">
          <span data-lang="pt"
            >Uma sessão do Pi não é um log de chat linear — é uma
            <em>árvore</em> num único arquivo JSONL. Domine ramificação e
            <em>compaction</em> e sessões longas deixam de assustar: você pode
            rebobinar, bifurcar e encolher contexto sem nunca apagar seu
            trabalho.</span
          ><span data-lang="en"
            >A Pi session isn't a linear chat log — it's a <em>tree</em> in a
            single JSONL file. Master branching and compaction and long sessions
            stop being scary: you can rewind, fork, and shrink context without
            ever deleting your work.</span
          >
        </p>
        <p class="lesson-nav-top">
          ↑
          <span data-lang="pt"
            ><a href="../MISSION.md">Missão</a> · anterior:</span
          ><span data-lang="en"
            ><a href="../MISSION.md">Mission</a> · prev:</span
          >
          <a href="./0002-driving-the-tui.html"
            ><span data-lang="pt">Lição 2 · Dirigindo o TUI</span
            ><span data-lang="en">Lesson 2 · Driving the TUI</span></a
          >
          · <span data-lang="pt">ref:</span><span data-lang="en">ref:</span>
          <a href="../reference/pi-glossary.html"
            ><span data-lang="pt">Glossário</span
            ><span data-lang="en">Glossary</span></a
          >
        </p>
      </header>

      <!-- ===================== 1. THE REFRAME ===================== -->
      <h2 class="section">
        <span class="num">1</span
        ><span data-lang="pt">Uma sessão é uma árvore, não um log</span
        ><span data-lang="en">A session is a tree, not a log</span>
      </h2>
      <p class="kicker">
        <span data-lang="pt"
          >Cada entrada tem um <code class="inline">id</code> e um
          <code class="inline">parentId</code>. Sua posição atual é a
          <strong>folha ativa</strong>. Não existe “desfazer” — existe apenas
          <em>navegar</em>. Um único arquivo guarda cada ramo que você já
          explorou.</span
        ><span data-lang="en"
          >Every entry has an <code class="inline">id</code> and a
          <code class="inline">parentId</code>. Your current position is the
          <strong>active leaf</strong>. There's no "undo" — there's only
          <em>navigate</em>. One file holds every branch you ever
          explored.</span
        >
      </p>

      <div class="scroll-x" style="margin: 22px 0 8px">
        <svg
          viewBox="0 0 820 320"
          width="100%"
          role="img"
          aria-labelledby="t1"
          style="min-width: 820px"
        >
          <title
            id="t1"
            data-pt="Uma árvore de sessão com dois ramos num arquivo JSONL; o caminho ativo está destacado"
            data-en="A session tree with two branches in one JSONL file; the active path is highlighted"
          >
            Uma árvore de sessão com dois ramos
          </title>
          <!-- connectors -->
          <g fill="none" stroke-width="3">
            <path d="M120 170 C 160 170, 165 170, 200 170" stroke="#8b6ff7" />
            <path d="M300 160 C 330 130, 335 110, 360 100" stroke="#2dd4bf" />
            <path d="M460 96  C 490 96, 495 96, 530 96" stroke="#2dd4bf" />
            <path d="M630 96  C 660 96, 665 96, 700 96" stroke="#2dd4bf" />
            <path
              d="M300 180 C 330 215, 335 245, 360 252"
              stroke="#3a3f55"
              stroke-dasharray="5 5"
            />
            <path
              d="M460 256 C 490 256, 495 256, 530 256"
              stroke="#3a3f55"
              stroke-dasharray="5 5"
            />
          </g>

          <!-- nodes -->
          <g font-family="JetBrains Mono" font-size="11" font-weight="700">
            <!-- A root -->
            <rect x="60" y="150" width="60" height="40" rx="9" fill="#8b6ff7" />
            <text
              x="90"
              y="174"
              text-anchor="middle"
              fill="#fff"
              data-pt="A·usr"
              data-en="A·usr"
            >
              A·usr
            </text>
            <!-- B -->
            <rect
              x="200"
              y="150"
              width="100"
              height="40"
              rx="9"
              fill="#8b6ff7"
            />
            <text
              x="250"
              y="174"
              text-anchor="middle"
              fill="#fff"
              data-pt="B·assistente"
              data-en="B·assistant"
            >
              B·assistente
            </text>
            <!-- active branch -->
            <rect
              x="360"
              y="76"
              width="100"
              height="40"
              rx="9"
              fill="#2dd4bf"
            />
            <text
              x="410"
              y="100"
              text-anchor="middle"
              fill="#fff"
              data-pt='C·"plano A"'
              data-en='C·"plan A"'
            >
              C·"plano A"
            </text>
            <rect
              x="530"
              y="76"
              width="100"
              height="40"
              rx="9"
              fill="#2dd4bf"
            />
            <text
              x="580"
              y="100"
              text-anchor="middle"
              fill="#fff"
              data-pt="D·assistente"
              data-en="D·assistant"
            >
              D·assistente
            </text>
            <rect
              x="700"
              y="70"
              width="104"
              height="52"
              rx="9"
              fill="#181a26"
              stroke="#2dd4bf"
              stroke-width="3"
            />
            <text
              x="752"
              y="94"
              text-anchor="middle"
              fill="#2dd4bf"
              data-pt='E·"funcionou!"'
              data-en='E·"worked!"'
            >
              E·"funcionou!"
            </text>
            <text
              x="752"
              y="110"
              text-anchor="middle"
              font-size="9"
              fill="#2dd4bf"
              data-pt="★ ATIVO"
              data-en="★ ACTIVE"
            >
              ★ ATIVO
            </text>
            <!-- abandoned branch -->
            <rect
              x="360"
              y="232"
              width="100"
              height="40"
              rx="9"
              fill="#181a26"
              stroke="#3a3f55"
              stroke-width="2"
            />
            <text
              x="410"
              y="256"
              text-anchor="middle"
              fill="#a0a3b5"
              data-pt='F·"plano B"'
              data-en='F·"plan B"'
            >
              F·"plano B"
            </text>
            <rect
              x="530"
              y="232"
              width="100"
              height="40"
              rx="9"
              fill="#181a26"
              stroke="#3a3f55"
              stroke-width="2"
            />
            <text
              x="580"
              y="256"
              text-anchor="middle"
              fill="#a0a3b5"
              data-pt="G·assistente"
              data-en="G·assistant"
            >
              G·assistente
            </text>
          </g>

          <!-- annotations -->
          <text
            x="752"
            y="58"
            text-anchor="middle"
            font-family="Inter"
            font-size="11"
            fill="#2dd4bf"
            font-weight="600"
            data-pt="você está aqui"
            data-en="you are here"
          >
            você está aqui
          </text>
          <text
            x="580"
            y="300"
            text-anchor="middle"
            font-family="Inter"
            font-size="11"
            fill="#a0a3b5"
            data-pt="ramo abandonado — ainda no arquivo"
            data-en="abandoned branch — still in the file"
          >
            ramo abandonado — ainda no arquivo
          </text>
          <text
            x="410"
            y="40"
            text-anchor="middle"
            font-family="Space Grotesk"
            font-size="11"
            fill="#2dd4bf"
            font-weight="700"
            data-pt="CAMINHO ATIVO (no contexto)"
            data-en="ACTIVE PATH (in context)"
          >
            CAMINHO ATIVO (no contexto)
          </text>
        </svg>
      </div>
      <div class="callout key">
        <p>
          <span data-lang="pt"
            ><strong>A mudança de enquadramento:</strong> “voltar e tentar outra
            coisa” não descarta nada — faz crescer um novo ramo. O caminho
            antigo fica no mesmo JSONL para sempre. Você não está editando o
            histórico; está <em>navegando</em> uma árvore.</span
          ><span data-lang="en"
            ><strong>The reframe:</strong> "go back and try something else"
            doesn't discard anything — it grows a new branch. The old path stays
            in the same JSONL forever. You're not editing history; you're
            <em>navigating</em> a tree.</span
          >
        </p>
      </div>
      <p class="cite">
        <span data-lang="pt">Fonte:</span><span data-lang="en">Source:</span>
        <a
          href="https://pi.dev/docs/latest/sessions"
          target="_blank"
          rel="noopener"
          ><span data-lang="pt">Pi docs · Sessões</span
          ><span data-lang="en">Pi docs · Sessions</span></a
        >
        · <span data-lang="pt">formato de arquivo em</span
        ><span data-lang="en">file format in</span>
        <a
          href="https://pi.dev/docs/latest/session-format"
          target="_blank"
          rel="noopener"
          >session-format</a
        >.
      </p>

      <!-- ===================== 2. /tree ===================== -->
      <h2 class="section">
        <span class="num">2</span><code>/tree</code>
        <span data-lang="pt">— navegue no lugar</span
        ><span data-lang="en">— navigate in place</span>
      </h2>
      <p class="kicker">
        <span data-lang="pt"
          >Abra com <span class="kbd">Esc</span> <span class="kbd">Esc</span>.
          Pule para qualquer ponto anterior e continue — mesmo arquivo, novo
          ramo.
          <em>O que você seleciona decide o que acontece a seguir.</em></span
        ><span data-lang="en"
          >Open it with <span class="kbd">Esc</span>
          <span class="kbd">Esc</span>. Jump to any earlier point and continue —
          same file, new branch.
          <em>What you select decides what happens next.</em></span
        >
      </p>

      <div class="grid cols-3" style="margin-top: 18px">
        <div class="card" style="border-top: 4px solid #2dd4bf">
          <h4>
            <span data-lang="pt">Selecione uma msg de <em>user</em></span
            ><span data-lang="en">Select a <em>user</em> msg</span>
          </h4>
          <p>
            <span data-lang="pt"
              >Folha → seu <strong>pai</strong>; o texto da mensagem cai no
              editor. Edite &amp; reenvie → cria um
              <strong>novo ramo</strong>.</span
            ><span data-lang="en"
              >Leaf → its <strong>parent</strong>; the message text drops into
              the editor. Edit &amp; resubmit → spawns a
              <strong>new branch</strong>.</span
            >
          </p>
        </div>
        <div class="card" style="border-top: 4px solid #8b6ff7">
          <h4>
            <span data-lang="pt"
              >Selecione uma msg de <em>assistant/tool</em></span
            ><span data-lang="en">Select an <em>assistant/tool</em> msg</span>
          </h4>
          <p>
            <span data-lang="pt"
              >Folha → essa entrada; o editor fica vazio. Você apenas
              <strong>continua</strong> daquele ponto do histórico.</span
            ><span data-lang="en"
              >Leaf → that entry; editor stays empty. You simply
              <strong>continue</strong> from that point in history.</span
            >
          </p>
        </div>
        <div class="card" style="border-top: 4px solid #fbbf24">
          <h4>
            <span data-lang="pt">Selecione a <em>raiz</em></span
            ><span data-lang="en">Select the <em>root</em></span>
          </h4>
          <p>
            <span data-lang="pt"
              >Redefine para uma conversa vazia; o prompt original volta ao
              editor. Um reinício limpo, mesmo arquivo.</span
            ><span data-lang="en"
              >Resets to an empty conversation; the original prompt returns to
              the editor. A clean restart, same file.</span
            >
          </p>
        </div>
      </div>

      <h3 style="margin-top: 24px">
        <span data-lang="pt">Controles da árvore</span
        ><span data-lang="en">Tree controls</span>
      </h3>
      <div class="grid cols-2">
        <div class="card">
          <p>
            <span data-lang="pt"
              ><span class="kbd">↑</span><span class="kbd">↓</span> mover ·
              <span class="kbd">←</span><span class="kbd">→</span> paginar ·
              <span class="kbd">Enter</span> selecionar ·
              <span class="kbd">Esc</span> cancelar</span
            ><span data-lang="en"
              ><span class="kbd">↑</span><span class="kbd">↓</span> move ·
              <span class="kbd">←</span><span class="kbd">→</span> page ·
              <span class="kbd">Enter</span> select ·
              <span class="kbd">Esc</span> cancel</span
            >
          </p>
        </div>
        <div class="card">
          <p>
            <span data-lang="pt"
              ><span class="kbd">Ctrl</span>+<span class="kbd">←/→</span> (ou
              <span class="kbd">Alt</span>) recolher/expandir &amp; pular entre
              segmentos de ramo</span
            ><span data-lang="en"
              ><span class="kbd">Ctrl</span>+<span class="kbd">←/→</span> (or
              <span class="kbd">Alt</span>) fold/unfold &amp; jump between
              branch segments</span
            >
          </p>
        </div>
        <div class="card">
          <p>
            <span data-lang="pt"
              ><span class="kbd">Shift</span>+<span class="kbd">L</span>
              define/limpa um rótulo de marcador ·
              <span class="kbd">Shift</span>+<span class="kbd">T</span> alterna
              timestamps</span
            ><span data-lang="en"
              ><span class="kbd">Shift</span>+<span class="kbd">L</span>
              set/clear a bookmark label · <span class="kbd">Shift</span>+<span
                class="kbd"
                >T</span
              >
              toggle timestamps</span
            >
          </p>
        </div>
        <div class="card">
          <p>
            <span data-lang="pt"
              ><span class="kbd">Ctrl</span>+<span class="kbd">O</span> alterna
              filtro: padrão → sem-tools → só-user → só-rotulados → tudo</span
            ><span data-lang="en"
              ><span class="kbd">Ctrl</span>+<span class="kbd">O</span> cycle
              filter: default → no-tools → user-only → labeled-only → all</span
            >
          </p>
        </div>
      </div>
      <p class="cite">
        <span data-lang="pt"
          >Dica: marque pontos de virada com
          <span class="kbd">Shift</span>+<span class="kbd">L</span>, depois
          filtre por <em>só-rotulados</em> para voar por sessões longas. Defina
          o filtro padrão via <code class="inline">treeFilterMode</code> nas
          configurações.</span
        ><span data-lang="en"
          >Tip: bookmark turning points with
          <span class="kbd">Shift</span>+<span class="kbd">L</span>, then filter
          to <em>labeled-only</em> to fly through long sessions. Set the default
          filter via <code class="inline">treeFilterMode</code> in
          settings.</span
        >
      </p>

      <!-- ===================== 3. tree vs fork vs clone ===================== -->
      <h2 class="section">
        <span class="num">3</span><code>/tree</code> vs <code>/fork</code> vs
        <code>/clone</code>
      </h2>
      <p class="kicker">
        <span data-lang="pt"
          >Três jeitos de “voltar”. A diferença é simples:
          <strong>mesmo arquivo ou arquivo novo?</strong></span
        ><span data-lang="en"
          >Three ways to "go back." The difference is simple:
          <strong>same file or new file?</strong></span
        >
      </p>

      <div class="grid cols-3" style="margin-top: 18px">
        <div
          class="card"
          style="text-align: center; border-top: 4px solid #2dd4bf"
        >
          <div class="badge" style="background: #2dd4bf; margin: 0 auto 10px">
            🌳
          </div>
          <h4 style="text-align: center">/tree</h4>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt"><strong>Mesmo</strong> arquivo</span
            ><span data-lang="en"><strong>Same</strong> file</span>
          </p>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">Visão de árvore completa</span
            ><span data-lang="en">Full tree view</span>
          </p>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">Explore alternativas <em>no lugar</em></span
            ><span data-lang="en">Explore alternatives <em>in place</em></span>
          </p>
          <p
            style="
              text-align: center;
              font-size: 0.85rem;
              color: var(--ink-soft);
            "
          >
            <span data-lang="pt">Resumo de ramo opcional</span
            ><span data-lang="en">Optional branch summary</span>
          </p>
        </div>
        <div
          class="card"
          style="text-align: center; border-top: 4px solid #8b6ff7"
        >
          <div class="badge" style="background: #8b6ff7; margin: 0 auto 10px">
            ⑂
          </div>
          <h4 style="text-align: center">/fork</h4>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">Arquivo <strong>novo</strong></span
            ><span data-lang="en"><strong>New</strong> file</span>
          </p>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">Pega uma mensagem de user passada</span
            ><span data-lang="en">Picks a past user message</span>
          </p>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">“E se eu tivesse perguntado diferente?”</span
            ><span data-lang="en">"What if I'd asked differently?"</span>
          </p>
          <p
            style="
              text-align: center;
              font-size: 0.85rem;
              color: var(--ink-soft);
            "
          >
            <span data-lang="pt">Sem resumo</span
            ><span data-lang="en">No summary</span>
          </p>
        </div>
        <div
          class="card"
          style="text-align: center; border-top: 4px solid #fbbf24"
        >
          <div class="badge" style="background: #fbbf24; margin: 0 auto 10px">
            ⧉
          </div>
          <h4 style="text-align: center">/clone</h4>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">Arquivo <strong>novo</strong></span
            ><span data-lang="en"><strong>New</strong> file</span>
          </p>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">Duplica o ramo ativo</span
            ><span data-lang="en">Duplicates active branch</span>
          </p>
          <p style="text-align: center; font-size: 0.85rem">
            <span data-lang="pt">Snapshot antes de uma mudança arriscada</span
            ><span data-lang="en">Snapshot before a risky change</span>
          </p>
          <p
            style="
              text-align: center;
              font-size: 0.85rem;
              color: var(--ink-soft);
            "
          >
            <span data-lang="pt">Sem resumo</span
            ><span data-lang="en">No summary</span>
          </p>
        </div>
      </div>
      <div class="callout tip">
        <p>
          <span data-lang="pt"
            ><strong>Regra prática:</strong>
            <code class="inline">/tree</code> mantém alternativas
            <em>juntas</em>; <code class="inline">/fork</code> &amp;
            <code class="inline">/clone</code> separam-nas em
            <em>arquivos separados</em>. Use
            <code class="inline">/clone</code> como um “ponto de salvamento”
            barato antes de deixar o Pi fazer algo destrutivo.</span
          ><span data-lang="en"
            ><strong>Rule of thumb:</strong>
            <code class="inline">/tree</code> keeps alternatives
            <em>together</em>; <code class="inline">/fork</code> &amp;
            <code class="inline">/clone</code> split them into
            <em>separate files</em>. Use <code class="inline">/clone</code> as a
            cheap "save point" before letting Pi do something destructive.</span
          >
        </p>
      </div>

      <!-- ===================== 4. CLI session control ===================== -->
      <h2 class="section">
        <span class="num">4</span
        ><span data-lang="pt">Controle de sessão pelo shell</span
        ><span data-lang="en">Session control from the shell</span>
      </h2>
      <p class="kicker">
        <span data-lang="pt"
          >Você não precisa estar dentro do Pi para gerenciar sessões. Essas
          flags rodam na inicialização.</span
        ><span data-lang="en"
          >You don't have to be inside Pi to manage sessions. These flags run at
          startup.</span
        >
      </p>

      <pre
        class="block"
      ><span class="c"><span data-lang="pt"># retomar / escolher</span><span data-lang="en"># resume / pick</span></span>
pi -c                      <span class="c"><span data-lang="pt"># continua a sessão mais recente</span><span data-lang="en"># continue most recent session</span></span>
pi -r                      <span class="c"><span data-lang="pt"># navega &amp; seleciona (igual /resume)</span><span data-lang="en"># browse &amp; select (same as /resume)</span></span>
pi --session &lt;path|id&gt;     <span class="c"><span data-lang="pt"># pula para um arquivo específico ou UUID parcial</span><span data-lang="en"># jump to a specific file or partial UUID</span></span>
pi --fork &lt;path|id&gt;        <span class="c"><span data-lang="pt"># bifurca uma sessão existente num arquivo novo</span><span data-lang="en"># fork an existing session into a new file</span></span>

<span class="c"><span data-lang="pt"># nome &amp; efêmera</span><span data-lang="en"># name &amp; ephemeral</span></span>
pi --name <span class="s">"Refactor auth"</span>   <span class="c"><span data-lang="pt"># nomeada = encontrável depois (também /name)</span><span data-lang="en"># named = findable later (also /name)</span></span>
pi --no-session            <span class="c"><span data-lang="pt"># efêmera: não salva nada</span><span data-lang="en"># ephemeral: don't save anything</span></span></pre>

      <div class="card" style="margin-top: 14px">
        <h4>
