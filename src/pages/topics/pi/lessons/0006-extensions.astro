      <!-- ===================== 4. INTERCEPTION ===================== -->
      <h2 class="section">
        <span class="num">4</span
        ><span data-lang="pt">Interceptação — o portão de segurança</span
        ><span data-lang="en">Interception — the safety gate</span>
      </h2>
      <p class="kicker">
        <span data-lang="pt"
          >O padrão de poder canônico: pegar um comando perigoso
          <em>antes</em> de ele rodar e perguntar ao humano.
          <code class="inline">tool_call</code> pode retornar
          <code class="inline">{ block: true }</code> ou alterar
          <code class="inline">event.input</code>.</span
        ><span data-lang="en"
          >The canonical power pattern: catch a dangerous command
          <em>before</em> it runs and ask the human.
          <code class="inline">tool_call</code> can return
          <code class="inline">{ block: true }</code> or mutate
          <code class="inline">event.input</code>.</span
        >
      </p>

      <pre
        class="block"
      ><span class="c">// ~/.pi/agent/extensions/safety.ts</span>
<span class="k">import</span> { isToolCallEventType, <span class="k">type</span> ExtensionAPI } <span class="k">from</span> <span class="s">"@earendil-works/pi-coding-agent"</span>;

<span class="k">export default function</span> (pi: ExtensionAPI) {
  pi.on(<span class="s">"tool_call"</span>, <span class="k">async</span> (event, ctx) =&gt; {
    <span class="k">if</span> (!isToolCallEventType(<span class="s">"bash"</span>, event)) <span class="k">return</span>;
    <span class="k">if</span> (/\brm\s+-rf\b/.test(event.input.command)) {
      <span class="k">const</span> ok = <span class="k">await</span> ctx.ui.confirm(
        <span class="s">"Dangerous command"</span>,
        <span class="s">`Allow: ${event.input.command}?`</span>
      );
      <span class="k">if</span> (!ok) <span class="k">return</span> { block: <span class="k">true</span>, reason: <span class="s">"Blocked by user"</span> };
    }
  });
}</pre>
