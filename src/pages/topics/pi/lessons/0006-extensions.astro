        ><span data-lang="en"
          >Give the model a verb it didn't have. Define params with
          <strong>typebox</strong>; return
          <code class="inline">{ content, details }</code>.</span
        >
      </p>

      <pre class="block">pi.registerTool({
  name: <span class="s">"deploy"</span>,
  label: <span class="s">"Deploy"</span>,
  description: <span class="s">"Deploy the current branch to staging."</span>,
  parameters: Type.Object({
    env: StringEnum([<span class="s">"staging"</span>, <span class="s">"prod"</span>] <span class="k">as const</span>),
  }),
  <span class="k">async</span> execute(toolCallId, params, signal, onUpdate, ctx) {
    onUpdate?.({ content: [{ type: <span class="s">"text"</span>, text: <span class="s">"building…"</span> }] });
    <span class="k">const</span> out = <span class="k">await</span> runBuild(params.env);
    <span class="k">return</span> {
      content: [{ type: <span class="s">"text"</span>, text: <span class="s">`deployed to ${params.env}`</span> }],
      details: { env: params.env, log: out },
    };
  },
});</pre>
