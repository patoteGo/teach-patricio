---
// Português · Lesson 2 — the five accent markers + the ChatGPT voice tutor prompt.
// Registered in: assets/nav.js, hub (src/pages/index.astro), README (auto-gen), chained from lesson 0001.
import Lesson from "../../../../layouts/Lesson.astro";
const titlePt = "Sotaque — as cinco marcas que entregam";
const titleEn = "Accent — the five giveaway markers";
const titleFallback = "Sotaque — as cinco marcas que entregam";
const bodyClass = "lang-pt";
const viewport = "width=device-width, initial-scale=1.0";
const assets = [
	"<link rel=\"stylesheet\" href=\"../assets/style.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/dark.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/i18n.css\" />",
	"<script src=\"https://unpkg.com/@phosphor-icons/web@2.1.1\"></script>",
	"<script src=\"../assets/i18n.js\" defer></script>",
	"<script src=\"../assets/nav.js\" defer></script>",
	"<script src=\"../assets/reading-ui.js\" defer></script>",
];

---
<Lesson
	titlePt={titlePt}
	titleEn={titleEn}
	titleFallback={titleFallback}
	bodyClass={bodyClass}
	viewport={viewport}
	assets={assets}
>
	<Fragment is:raw>
    <article class="lesson">
      <header class="hero">
        <span class="eyebrow">⬡ Português · Lição 2</span>
        <h1>
          <span data-lang="pt">As cinco marcas que entregam.</span
          ><span data-lang="en">The five markers that give you away.</span>
        </h1>
        <p class="lead">
          <span data-lang="pt"
            >Vocabulário você tem. O que entrega o falante de espanhol é o
            <strong>som</strong> — vogais cheias demais, T e D duros demais.
            Nesta lição: os cinco marcadores nº 1, e um prompt para transformar
            o ChatGPT no professor que <strong>te corrige de verdade</strong> na
            conversa.</span
          ><span data-lang="en"
            >You have the vocabulary. What gives a Spanish speaker away is the
            <strong>sound</strong> — vowels too full, T and D too hard. In this
            lesson: the five #1 markers, and a prompt that turns ChatGPT into a
            tutor who <strong>actually corrects you</strong> in
            conversation.</span
          >
        </p>
      </header>

      <h2 class="section">
        <span class="num">1</span
        ><span data-lang="pt">Por que o sotaque persiste</span
        ><span data-lang="en">Why the accent persists</span>
      </h2>
      <p>
        <span data-lang="pt"
          >O espanhol tem <strong>cinco vogais fortes e estáveis</strong>,
          sempre cheias. O português brasileiro
          <strong>engole e transforma vogais</strong>: reduz as átonas, nasaliza
          outras, palataliza T e D. Seu ouvido espanhol acha que está falando
          certo — e o brasileiro entende tudo, então ninguém corrige.</span
        ><span data-lang="en"
          >Spanish has <strong>five strong, stable vowels</strong>, always
          full. Brazilian Portuguese <strong>swallows and transforms
          vowels</strong>: reduces unstressed ones, nasalizes others,
          palatalizes T and D. Your Spanish ear thinks it's right — and
          Brazilians understand everything, so nobody corrects you.</span
        >
      </p>
      <div class="callout key">
        <span data-lang="pt"
          ><i class="ph ph-waveform" aria-hidden="true"></i>
          Sotaque não se conserta lendo: conserta com
          <strong>boca + correção imediata + repetição</strong>. É isso que esta
          lição monta.</span
        ><span data-lang="en"
          ><i class="ph ph-waveform" aria-hidden="true"></i>
          Accent isn't fixed by reading: it's fixed with
          <strong>mouth + immediate correction + repetition</strong>. That's
          what this lesson assembles.</span
        >
      </div>
      <p class="cite">
        <a
          href="https://www.coerll.utexas.edu/brazilpod/tafalado/lesson.php?p=01"
          >Tá Falado (UT Austin) — Lição 01: as vogais</a
        >
      </p>

      <h2 class="section">
        <span class="num">2</span
        ><span data-lang="pt">Os cinco marcadores</span
        ><span data-lang="en">The five markers</span>
      </h2>
      <p>
        <span data-lang="pt"
          >Cada card: o que o espanhol faz → o que o brasileiro faz → a
          <strong>palavra-treino para dizer em voz alta agora</strong>.</span
        ><span data-lang="en"
          >Each card: what Spanish does → what the Brazilian does → the
          <strong>drill word to say out loud right now</strong>.</span
        >
      </p>
      <div class="grid cols-2">
        <div class="card">
          <h3>1 · Vogais átonas cheias</h3>
          <p>
            <span data-lang="pt"
              >ES diz "dedo" com dois e iguais.
              <strong>PT reduz: "dêdu"</strong> — o e final vira i, o o final
              vira u (queij<u>o</u> → "queij<u>u</u>").</span
            ><span data-lang="en"
              >ES says "dedo" with two identical e's.
              <strong>PT reduces: "dêdu"</strong> — final e becomes i, final o
              becomes u.</span
            >
          </p>
          <p>
            <strong data-lang="pt">Treino: "dedo, queijo, banana".</strong
            ><strong data-lang="en">Drill: "dedo, queijo, banana".</strong>
          </p>
        </div>
        <div class="card">
          <h3>2 · T e D duros</h3>
          <p>
            <span data-lang="pt"
              >ES diz "tía" com T reto.
              <strong>PT palataliza: "tchia"</strong> — tia→tchia, dia→djia,
              tarde→"tardji". É o som mais brasileiro que existe.</span
            ><span data-lang="en"
              >ES says "tía" with a plain T.
              <strong>PT palatalizes: "tchia"</strong> — tia→tchia, dia→djia,
              tarde→"tardji". The most Brazilian sound there is.</span
            >
          </p>
          <p>
            <strong data-lang="pt">Treino: "todo dia, minha tia".</strong
            ><strong data-lang="en">Drill: "todo dia, minha tia".</strong>
          </p>
        </div>
        <div class="card">
          <h3>3 · Vogal nasal ausente</h3>
          <p>
            <span data-lang="pt"
              >ES não tem vogais nasais: o brasileiro fecha e ressoa
              <strong>no nariz — "pão", "não", "bom"</strong>. Sem nasal, vira
              "pao", "nao".</span
            ><span data-lang="en"
              >ES has no nasal vowels: Brazilians close and resonate
              <strong>through the nose — "pão", "não", "bom"</strong>. Without
              nasality it becomes "pao", "nao".</span
            >
          </p>
          <p>
            <strong data-lang="pt">Treino: "pão, não, bom, mãe".</strong
            ><strong data-lang="en">Drill: "pão, não, bom, mãe".</strong>
          </p>
        </div>
        <div class="card">
          <h3>4 · R inicial de jota</h3>
          <p>
            <span data-lang="pt"
              >O rr espanhol vibra na garganta.
              <strong>O R inicial do PT é suave, quase H</strong>: Rio→"Hio",
              restaurante→"hestaurante". Nada de "Jio".</span
            ><span data-lang="en"
              >Spanish rr vibrates in the throat.
              <strong>PT's initial R is soft, almost an H</strong>:
              Rio→"Hio", restaurante→"hestaurante". Not "Jio".</span
            >
          </p>
          <p>
            <strong data-lang="pt">Treino: "Rio de Janeiro".</strong
            ><strong data-lang="en">Drill: "Rio de Janeiro".</strong>
          </p>
        </div>
        <div class="card">
          <h3>5 · avó ≠ avô</h3>
          <p>
            <span data-lang="pt"
              >Vogal tônica aberta/fechada muda o sentido:
              <strong>avó (aberta) é avó; avô (fechada) é avô</strong>. O mesmo
              vale em pêra/pedra, ê/é, ô/ó.</span
            ><span data-lang="en"
              >Open/closed stressed vowels change meaning:
              <strong>avó (open) is grandma; avô (closed) is grandpa</strong>.
              Same for ê/é, ô/ó pairs.</span
            >
          </p>
          <p>
            <strong data-lang="pt">Treino: "minha avó, meu avô".</strong
            ><strong data-lang="en">Drill: "minha avó, meu avô".</strong>
          </p>
        </div>
        <div class="card">
          <h3>
            <span data-lang="pt">A ordem de prioridade</span
            ><span data-lang="en">Priority order</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Se for atacar um por vez: <strong>1 e 2 primeiro</strong> — são
              os que aparecem em cada frase que você fala.</span
            ><span data-lang="en"
              >If attacking one at a time: <strong>1 and 2 first</strong> —
              they show up in every sentence you speak.</span
            >
          </p>
        </div>
      </div>
      <p class="cite">
        <a href="https://www.coerll.utexas.edu/brazilpod/tafalado/"
          >Tá Falado — 24 lições de pronúncia ES→PT</a
        >
      </p>

      <h2 class="section">
        <span class="num">3</span
        ><span data-lang="pt">Recupere sem pistas</span
        ><span data-lang="en">Retrieve without clues</span>
      </h2>

      <div class="quiz" id="q1" role="group" aria-labelledby="q1l">
        <div class="q" id="q1l">
          <span data-lang="pt"
            >1. A última vogal de "queijo", falada por um brasileiro, soa
            como:</span
          ><span data-lang="en"
            >1. The last vowel of "queijo", as a Brazilian says it, sounds
            like:</span
          >
        </div>
        <div class="options">
          <button class="opt" data-correct="false" data-fb-pt="O o final cheio é o hábito espanhol — o brasileiro reduz." data-fb-en="A full final o is the Spanish habit — Brazilians reduce it.">o</button>
          <button class="opt" data-correct="true" data-fb-pt="Exato: o o átono final vira u — 'queiju'." data-fb-en="Exact: the unstressed final o becomes u — 'queiju'.">u</button>
          <button class="opt" data-correct="false" data-fb-pt="I é o e final que vira i ('dedi'). Aqui é o." data-fb-en="I is what final e becomes ('dedi'). This one is o.">i</button>
          <button class="opt" data-correct="false" data-fb-pt="A não aparece aqui — a vogal escrita é o." data-fb-en="A isn't even written here — the written vowel is o.">a</button>
        </div>
        <p class="verdict"></p>
      </div>

      <div class="quiz" id="q2" role="group" aria-labelledby="q2l">
        <div class="q" id="q2l">
          <span data-lang="pt">2. Um brasileiro pronuncia "tia" como:</span
          ><span data-lang="en">2. A Brazilian pronounces "tia" as:</span>
        </div>
        <div class="options">
          <button class="opt" data-correct="false" data-fb-pt="T reto é a interferência espanhola — a marca nº 1 do sotaque." data-fb-en="A plain T is the Spanish interference — accent marker #1.">tia</button>
          <button class="opt" data-correct="true" data-fb-pt="Exato: T + i vira tch — 'tchia'." data-fb-en="Exact: T + i becomes tch — 'tchia'.">tchia</button>
          <button class="opt" data-correct="false" data-fb-pt="Perdeu o T — a palatalização mantém o começo do som." data-fb-en="That drops the T — palatalization keeps the sound's onset.">chia</button>
          <button class="opt" data-correct="false" data-fb-pt="Isso é o D (dia→djia). Para T é tch." data-fb-en="That's the D (dia→djia). For T it's tch.">djia</button>
        </div>
        <p class="verdict"></p>
      </div>

      <div class="quiz" id="q3" role="group" aria-labelledby="q3l">
        <div class="q" id="q3l">
          <span data-lang="pt">3. O que acontece com a vogal de "pão"?</span
          ><span data-lang="en">3. What happens to the vowel in "pão"?</span>
        </div>
        <div class="options">
          <button class="opt" data-correct="false" data-fb-pt="Cheia e oral é como o espanhol falaria — 'pao'." data-fb-en="Full and oral is how Spanish would say it — 'pao'.">fica cheia</button>
          <button class="opt" data-correct="true" data-fb-pt="Exato: é nasal — o ar passa pelo nariz na vogal, não depois." data-fb-en="Exact: it's nasal — air flows through the nose in the vowel, not after.">fica nasal</button>
          <button class="opt" data-correct="false" data-fb-pt="Aberta/fechada é o par avó/avô — aqui a diferença é a nasalidade." data-fb-en="Open/closed is the avó/avô pair — here the difference is nasality.">fica aberta</button>
          <button class="opt" data-correct="false" data-fb-pt="A vogal não desaparece — ela ressoa no nariz." data-fb-en="The vowel doesn't vanish — it resonates through the nose.">some inteira</button>
        </div>
        <p class="verdict"></p>
      </div>

      <div class="quiz" id="q4" role="group" aria-labelledby="q4l">
        <div class="q" id="q4l">
          <span data-lang="pt">4. O R de "Rio" em português brasileiro soa:</span
          ><span data-lang="en"
            >4. The R in "Rio" in Brazilian Portuguese sounds:</span
          >
        </div>
        <div class="options">
          <button class="opt" data-correct="false" data-fb-pt="Vibrado é o R de 'caro', não o inicial." data-fb-en="Tapped is the R in 'caro', not the initial one.">vibrado</button>
          <button class="opt" data-correct="false" data-fb-pt="Gutural de jota é exatamente o hábito espanhol a matar." data-fb-en="A guttural jota is exactly the Spanish habit to kill.">gutural</button>
          <button class="opt" data-correct="true" data-fb-pt="Exato: quase um H suave — 'Hio'." data-fb-en="Exact: almost a soft H — 'Hio'.">aspirado</button>
          <button class="opt" data-correct="false" data-fb-pt="O R inicial existe, só não vibra — é suave." data-fb-en="The initial R exists, it just doesn't tap — it's soft.">mudo</button>
        </div>
        <p class="verdict"></p>
      </div>

      <div class="quiz" id="q5" role="group" aria-labelledby="q5l">
        <div class="q" id="q5l">
          <span data-lang="pt">5. "Avô" (com ô fechado) é o seu:</span
          ><span data-lang="en">5. "Avô" (closed ô) is your:</span>
        </div>
        <div class="options">
          <button class="opt" data-correct="false" data-fb-pt="Mãe da mãe é avó — com ó aberto." data-fb-en="Mother's mother is avó — with open ó.">mãe da mãe</button>
          <button class="opt" data-correct="true" data-fb-pt="Exato: avô (fechado) = pai do pai; avó (aberto) = mãe." data-fb-en="Exact: avô (closed) = father's father; avó (open) = mother.">pai do pai</button>
          <button class="opt" data-correct="false" data-fb-pt="Pai da mãe também é avô — mas a opção clássica de contraste é pai do pai." data-fb-en="Mother's father is also avô — but the classic contrast is father's father.">pai da mãe</button>
          <button class="opt" data-correct="false" data-fb-pt="Irmão do pai é tio." data-fb-en="Father's brother is tio.">irmão do pai</button>
        </div>
        <p class="verdict"></p>
      </div>

      <h2 class="section">
        <span class="num">4</span
        ><span data-lang="pt"
          >Seu professor que corrige: o prompt do ChatGPT</span
        ><span data-lang="en"
          >The tutor who corrects: the ChatGPT prompt</span
        >
      </h2>
      <p>
        <span data-lang="pt"
          >A conversa real é onde o sotaque morre — se alguém corrigir. Este
          prompt transforma o ChatGPT em professor brasileiro com
          <strong>ouvido clínico e correção imediata</strong>, por voz.</span
        ><span data-lang="en"
          >Real conversation is where accents die — if someone corrects you.
          This prompt turns ChatGPT into a Brazilian tutor with
          <strong>clinical hearing and immediate correction</strong>, over
          voice.</span
        >
      </p>
      <div class="card">
        <h3>
          <span data-lang="pt">Como usar</span
          ><span data-lang="en">How to use</span>
        </h3>
        <ol>
          <li>
            <span data-lang="pt"
              >Copie o prompt abaixo e cole num chat novo do ChatGPT.</span
            ><span data-lang="en"
              >Copy the prompt below into a new ChatGPT chat.</span
            >
          </li>
          <li>
            <span data-lang="pt"
              >Ative o <strong>modo de voz</strong> (ícone de fone).</span
            ><span data-lang="en"
              >Switch on <strong>voice mode</strong> (headphone icon).</span
            >
          </li>
          <li>
            <span data-lang="pt"
              >Converse <strong>10 minutos</strong>. Peça o relatório final — e
              guarde: ele abre a próxima sessão.</span
            ><span data-lang="en"
              >Talk for <strong>10 minutes</strong>. Ask for the final report —
              keep it: it opens the next session.</span
            >
          </li>
        </ol>
      </div>
      <button class="opt" id="copybtn" type="button" style="margin: 6px 0">
        <i class="ph ph-copy" aria-hidden="true"></i>
        <span data-lang="pt">Copiar prompt</span
        ><span data-lang="en">Copy prompt</span>
      </button>
      <pre class="block" id="promptbox"><code>Você é meu professor de português brasileiro, com ouvido clínico e paciência infinita. Vamos conversar por voz, e o seu trabalho é me corrigir de verdade.

QUEM SOU EU: falante nativo de espanhol, moro no Brasil, sonho em soar nativo. Meus erros clássicos: falsos amigos do espanhol (exquisito→delicioso, apellido→sobrenome), vogais sempre cheias sem redução, T e D duros em vez de tch/dj (tia→tchia, dia→djia), vogais nasais ausentes (pão→pao), R inicial de jota espanhola em vez de R suave quase H.

SUAS REGRAS:
1. Converse comigo em português brasileiro natural, velocidade normal, como um amigo brasileiro.
2. Me corrija NA HORA em que eu errar: mostre o que eu disse → como um nativo diria → o porquê em uma linha.
3. Corrija pronúncia E escolha de palavras. Não me poupe: eu quero ser corrigido, não compreendido.
4. Depois de cada correção, me faça repetir a frase certa duas vezes antes de seguir.
5. Se eu acertar três trocas seguidas, aumente a dificuldade do assunto.
6. Ao final, me dê um relatório: meus três erros mais frequentes, a versão nativa de cada um, e duas frases para eu treinar até a próxima sessão.
7. Se eu colar um relatório de sessão anterior no começo, retome dali.

Comece agora: pergunte sobre o meu dia de hoje.</code></pre>
      <div class="callout key">
        <span data-lang="pt"
          ><i class="ph ph-microphone" aria-hidden="true"></i>
          <strong>Regra de ouro da sessão:</strong> quando corrigir, repita a
          frase certa em voz alta duas vezes. A boca aprende repetindo, não
          ouvindo.</span
        ><span data-lang="en"
          ><i class="ph ph-microphone" aria-hidden="true"></i>
          <strong>Golden rule of the session:</strong> when corrected, say the
          right sentence out loud twice. The mouth learns by repeating, not by
          listening.</span
        >
      </div>

      <h2 class="section">
        <span class="num">5</span
        ><span data-lang="pt">Ritual de fixação (7 dias)</span
        ><span data-lang="en">Fixation ritual (7 days)</span>
      </h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>
            <span data-lang="pt">Todo dia (2 min)</span
            ><span data-lang="en">Every day (2 min)</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Diga em voz alta as 5 palavras-treino, exagerando:
              <strong>dedo, tia, pão, Rio, avô</strong>.</span
            ><span data-lang="en"
              >Say the 5 drill words out loud, exaggerated:
              <strong>dedo, tia, pão, Rio, avô</strong>.</span
            >
          </p>
        </div>
        <div class="card">
          <h3>
            <span data-lang="pt">3× na semana (10 min)</span
            ><span data-lang="en">3× a week (10 min)</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Sessão de voz com o prompt, colando o relatório da sessão
              anterior.</span
            ><span data-lang="en"
              >Voice session with the prompt, pasting the previous report.</span
            >
          </p>
        </div>
        <div class="card">
          <h3>
            <span data-lang="pt">Dia 7</span><span data-lang="en">Day 7</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Peça a um brasileiro: "como está meu 'tia' e meu 'queijo'?" —
              <strong>feedback de ouvido nativo</strong>.</span
            ><span data-lang="en"
              >Ask a Brazilian: "how is my 'tia' and my 'queijo'?" —
              <strong>native-ear feedback</strong>.</span
            >
          </p>
        </div>
        <div class="card">
          <h3>
            <span data-lang="pt">Em 3 dias</span
            ><span data-lang="en">In 3 days</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Refaça o quiz da lição 1 (falsos amigos) sem reler.</span
            ><span data-lang="en"
              >Retake lesson 1's quiz (false friends) without rereading.</span
            >
          </p>
        </div>
      </div>

      <footer class="lesson-foot">
        <div>
          <span data-lang="pt">Fonte primária:</span
          ><span data-lang="en">Primary source:</span>
          <a href="https://www.coerll.utexas.edu/brazilpod/tafalado/"
            >Tá Falado (UT Austin)</a
          >
          <span data-lang="pt"
            >— ouça as lições de pronúncia 1–4 nesta semana (são curtas).</span
          ><span data-lang="en"
            >— listen to pronunciation lessons 1–4 this week (they're
            short).</span
          >
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap">
          <a class="next-card" href="0001-falsos-amigos-traicoeiros.html"
            ><span class="lbl"
              ><span data-lang="pt">Lição 1</span
              ><span data-lang="en">Lesson 1</span></span
            >
            <div class="t">
              <span data-lang="pt">← Falsos amigos traiçoeiros</span
              ><span data-lang="en">← Treacherous false friends</span>
            </div></a
          >
          <a class="next-card" href="../reference/falsos-amigos-espanhol.html"
            ><span class="lbl"
              ><span data-lang="pt">Referência</span
              ><span data-lang="en">Reference</span></span
            >
            <div class="t">
              <span data-lang="pt">Tabela de falsos amigos →</span
              ><span data-lang="en">False-friends table →</span>
            </div></a
          >
        </div>
        <div>
          <span data-lang="pt"
            ><i class="ph ph-chat-circle-dots" aria-hidden="true"></i> O prompt
            não funcionou bem? Me diga o que saiu torto — eu ajusto as regras
            para o seu caso. Também posso simular a conversa aqui, por
            texto.</span
          ><span data-lang="en"
            ><i class="ph ph-chat-circle-dots" aria-hidden="true"></i> The
            prompt didn't work well? Tell me what went wrong — I'll tune the
            rules for your case. I can also simulate the conversation here, in
            text.</span
          >
          · <a href="../../../index.html">⬡ Hub</a>
        </div>
      </footer>
    </article>

    <script>
      // copy-prompt button — clipboard with textarea fallback (repo pattern)
      const PROMPT = document
        .getElementById("promptbox")
        .textContent.trim();
      const cbtn = document.getElementById("copybtn");
      function flashCopied() {
        const lbls = cbtn.querySelectorAll("[data-lang]");
        const prev = Array.from(lbls).map((l) => l.innerHTML);
        lbls.forEach((l) => (l.textContent = "✓ Copiado"));
        setTimeout(() => {
          lbls.forEach((l, i) => (l.innerHTML = prev[i]));
        }, 1600);
      }
      cbtn.addEventListener("click", () => {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard
            .writeText(PROMPT)
            .then(flashCopied)
            .catch(() => fallbackCopy());
        } else fallbackCopy();
      });
      function fallbackCopy() {
        const ta = document.createElement("textarea");
        ta.value = PROMPT;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand("copy");
          flashCopied();
        } catch {}
        document.body.removeChild(ta);
      }

      // bilingual quiz wiring — data-correct + per-lang feedback
      function verdictFor(btn, quiz) {
        const correct = btn.dataset.correct === "true";
        const fb = btn.getAttribute(
          PiI18n.lang === "en" ? "data-fb-en" : "data-fb-pt",
        );
        const fallback =
          PiI18n.lang === "en"
            ? "✗ Not quite — re-read section 2."
            : "✗ Quase — releia a seção 2.";
        return {
          ok: correct,
          text: (correct ? "✓ " : "✗ ") + (fb || fallback),
        };
      }
      function resetQuiz(quiz) {
        quiz.querySelectorAll(".opt").forEach((b) => {
          b.classList.remove("correct", "wrong");
          b.setAttribute("aria-pressed", "false");
        });
        const v = quiz.querySelector(".verdict");
        v.textContent = "";
        v.className = "verdict";
      }
      document.querySelectorAll(".quiz").forEach((quiz) => {
        quiz.querySelectorAll(".opt").forEach((btn) => {
          btn.setAttribute("aria-pressed", "false");
          btn.addEventListener("click", () => {
            quiz.querySelectorAll(".opt").forEach((b) => {
              b.classList.remove("correct", "wrong");
              b.setAttribute("aria-pressed", "false");
            });
            const v = verdictFor(btn, quiz);
            btn.classList.add(v.ok ? "correct" : "wrong");
            btn.setAttribute("aria-pressed", "true");
            const verdict = quiz.querySelector(".verdict");
            verdict.textContent = v.text;
            verdict.className = "verdict " + (v.ok ? "ok" : "no");
          });
        });
      });
      document.addEventListener("DOMContentLoaded", () =>
        PiI18n.on(() => document.querySelectorAll(".quiz").forEach(resetQuiz)),
      );
    </script>
  </Fragment>
</Lesson>
