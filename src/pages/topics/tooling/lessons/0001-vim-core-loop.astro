import Lesson from "../../../../layouts/Lesson.astro";
const titlePt = "Vim — o loop essencial";
const titleEn = "Vim — the core loop";
const titleFallback = "Vim — the core loop";
const bodyClass = "lang-pt";
const viewport = "width=device-width, initial-scale=1.0";
const assets = [
	"<link rel=\"stylesheet\" href=\"../assets/style.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/dark.css\" />",
	"<link rel=\"stylesheet\" href=\"../assets/i18n.css\" />",
	"<script src=\"../assets/i18n.js\" defer></script>",
	"<script src=\"../assets/nav.js\" defer></script>",
	"<script src=\"../assets/reading-ui.js\" defer></script>",
];

---
<Lesson
	titlePt={titlePt}
	titleEn={titleEn}
	titleFallback={titleFallback}
	bodyClass={bodyClass}
	viewport={viewport}
	assets={assets}
>
	<Fragment is:raw>
    <article class="lesson">
      <header class="hero">
        <span class="eyebrow">⬡ Tooling · Vim 01</span>
        <h1>
          <span data-lang="pt">Entre. Edite. Saia.</span
          ><span data-lang="en">Enter. Edit. Leave.</span>
        </h1>
        <p class="lead">
          <span data-lang="pt"
            >Em 10 minutos, você vai editar um arquivo sem ficar preso — e sair
            com um treino de 5 minutos para repetir.</span
          ><span data-lang="en"
            >In 10 minutes, you will edit a file without getting trapped—and
            leave with a five-minute drill to repeat.</span
          >
        </p>
      </header>

      <h2 class="section">
        <span class="num">1</span
        ><span data-lang="pt">O modelo: modo → objetivo → comando</span
        ><span data-lang="en">The model: mode → intent → command</span>
      </h2>
      <p>
        <span data-lang="pt"
          >Vim é modal. Em
          <strong>Normal, as teclas são comandos; em Insert, são texto</strong>.
          Você começa em Normal.</span
        ><span data-lang="en"
          >Vim is modal. In
          <strong>Normal, keys are commands; in Insert, they are text</strong>.
          You start in Normal.</span
        >
      </p>
      <div class="grid cols-2">
        <div class="card">
          <span class="kbd">i</span>
          <h3>Normal → Insert</h3>
          <p>
            <span data-lang="pt">Agora digite texto.</span
            ><span data-lang="en">Now type text.</span>
          </p>
        </div>
        <div class="card">
          <span class="kbd">Esc</span>
          <h3>Insert → Normal</h3>
          <p>
            <span data-lang="pt">Agora mova ou edite.</span
            ><span data-lang="en">Now move or edit.</span>
          </p>
        </div>
      </div>
      <div class="callout key">
        <span data-lang="pt"
          >Se algo parecer estranho,
          <strong>pressione <span class="kbd">Esc</span></strong
          >. Isso devolve você ao ponto de partida.</span
        ><span data-lang="en"
          >If anything feels strange,
          <strong>press <span class="kbd">Esc</span></strong
          >. It returns you to the starting point.</span
        >
      </div>
      <p class="cite">
        <span data-lang="pt">Fonte primária:</span
        ><span data-lang="en">Primary source:</span>
        <a href="https://vimhelp.org/usr_02.txt.html#02.2"
          >Vim User Manual §02.2</a
        >
      </p>

      <h2 class="section">
        <span class="num">2</span
        ><span data-lang="pt">Seu primeiro vocabulário</span
        ><span data-lang="en">Your first vocabulary</span>
      </h2>
      <p>
        <span data-lang="pt"
          >Não memorize uma lista. Associe cada tecla a um objetivo:
          <strong>mover, inserir, apagar, recuperar ou sair</strong>.</span
        ><span data-lang="en"
          >Do not memorize a list. Tie each key to an intent:
          <strong>move, insert, delete, recover, or leave</strong>.</span
        >
      </p>
      <div class="grid cols-4">
        <div class="card">
          <span class="kbd">h</span>
          <p>←</p>
        </div>
        <div class="card">
          <span class="kbd">j</span>
          <p>↓</p>
        </div>
        <div class="card">
          <span class="kbd">k</span>
          <p>↑</p>
        </div>
        <div class="card">
          <span class="kbd">l</span>
          <p>→</p>
        </div>
        <div class="card">
          <span class="kbd">w</span>
          <p>
            <span data-lang="pt">próxima palavra</span
            ><span data-lang="en">next word</span>
          </p>
        </div>
        <div class="card">
          <span class="kbd">x</span>
          <p>
            <span data-lang="pt">apagar caractere</span
            ><span data-lang="en">delete character</span>
          </p>
        </div>
        <div class="card">
          <span class="kbd">dd</span>
          <p>
            <span data-lang="pt">apagar linha</span
            ><span data-lang="en">delete line</span>
          </p>
        </div>
        <div class="card">
          <span class="kbd">u</span>
          <p>
            <span data-lang="pt">desfazer</span><span data-lang="en">undo</span>
          </p>
        </div>
      </div>
      <div class="grid cols-2" style="margin-top: 16px">
        <div class="card">
          <h3><span class="kbd">:wq</span> + <span class="kbd">Enter</span></h3>
          <p>
            <span data-lang="pt">salvar e sair</span
            ><span data-lang="en">save and quit</span>
          </p>
        </div>
        <div class="card">
          <h3><span class="kbd">:q!</span> + <span class="kbd">Enter</span></h3>
          <p>
            <span data-lang="pt">sair e descartar mudanças</span
            ><span data-lang="en">quit and discard changes</span>
          </p>
        </div>
      </div>
      <p class="cite">
        <a href="https://vimhelp.org/usr_02.txt.html#02.3">movimento</a> ·
        <a href="https://vimhelp.org/usr_02.txt.html#02.4">edição</a> ·
        <a href="https://vimhelp.org/usr_02.txt.html#02.7">saída</a>
      </p>

      <h2 class="section">
        <span class="num">3</span
        ><span data-lang="pt">Faça agora: um circuito de 90 segundos</span
        ><span data-lang="en">Do it now: a 90-second circuit</span>
      </h2>
      <p>
        <span data-lang="pt"
          >Cole isto no terminal. O próprio arquivo dá feedback:
          <strong
            >termine com as duas linhas intactas e um <code>#</code> no
            início</strong
          >.</span
        ><span data-lang="en"
          >Paste this into a terminal. The file itself gives feedback:
          <strong
            >finish with both lines intact and a <code>#</code> at the
            start</strong
          >.</span
        >
      </p>
      <pre
        class="block"
      ><code>printf 'red green blue\nkeep this line\n' &gt; /tmp/vim-drill.txt
vim /tmp/vim-drill.txt</code></pre>
      <div class="card">
        <h3>
          <span data-lang="pt">Sequência</span
          ><span data-lang="en">Sequence</span>
        </h3>
        <ol>
          <li>
            <span class="kbd">i</span> digite <code># </code>, depois
            <span class="kbd">Esc</span>
          </li>
          <li>
            <span class="kbd">w</span>
            <span data-lang="pt">para avançar; use</span
            ><span data-lang="en">to move; use</span>
            <span class="kbd">h j k l</span>
          </li>
          <li>
            <span class="kbd">x</span>
            <span data-lang="pt">para apagar; imediatamente</span
            ><span data-lang="en">to delete; immediately</span>
            <span class="kbd">u</span> <span data-lang="pt">para recuperar</span
            ><span data-lang="en">to recover</span>
          </li>
          <li>
            <span class="kbd">j</span>, <span class="kbd">dd</span>,
            <span class="kbd">u</span>
            <span data-lang="pt">para apagar e restaurar a segunda linha</span
            ><span data-lang="en">to delete and restore the second line</span>
          </li>
          <li><span class="kbd">:wq</span>, <span class="kbd">Enter</span></li>
        </ol>
      </div>
      <pre class="block"><code>cat /tmp/vim-drill.txt
<span class="c"># esperado / expected:</span>
<span class="s"># red green blue
keep this line</span></code></pre>

      <h2 class="section">
        <span class="num">4</span
        ><span data-lang="pt">Muscle memory: 5 minutos × 7 dias</span
        ><span data-lang="en">Muscle memory: 5 minutes × 7 days</span>
      </h2>
      <p>
        <span data-lang="pt"
          >Automatização vem de executar, não reler.
          <strong
            >Tente lembrar antes de olhar e repita corretamente em sessões
            curtas</strong
          >.</span
        ><span data-lang="en"
          >Automaticity comes from doing, not rereading.
          <strong
            >Try to recall before looking and repeat accurately in short
            sessions</strong
          >.</span
        >
      </p>
      <div class="grid cols-2">
        <div class="card">
          <h3>
            <span data-lang="pt">Dias 1–2</span
            ><span data-lang="en">Days 1–2</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Repita o circuito 3 vezes. Sem setas, só durante o treino.</span
            ><span data-lang="en"
              >Repeat the circuit three times. No arrows, only during the
              drill.</span
            >
          </p>
        </div>
        <div class="card">
          <h3>
            <span data-lang="pt">Dias 3–4</span
            ><span data-lang="en">Days 3–4</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Rode <code>vimtutor</code> por 5 minutos. Pare no tempo.</span
            ><span data-lang="en"
              >Run <code>vimtutor</code> for five minutes. Stop on time.</span
            >
          </p>
        </div>
        <div class="card">
          <h3>
            <span data-lang="pt">Dias 5–6</span
            ><span data-lang="en">Days 5–6</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Use o circuito sem consultar esta página. Depois confira.</span
            ><span data-lang="en"
              >Do the circuit without this page. Check afterward.</span
            >
          </p>
        </div>
        <div class="card">
          <h3>
            <span data-lang="pt">Dia 7</span><span data-lang="en">Day 7</span>
          </h3>
          <p>
            <span data-lang="pt"
              >Edite um arquivo descartável real. Adicione só um comando
              novo.</span
            ><span data-lang="en"
              >Edit a real disposable file. Add only one new command.</span
            >
          </p>
        </div>
      </div>
      <div class="callout warn">
        <span data-lang="pt"
          >Não bloqueie as setas no trabalho inteiro ainda.
          <strong>A restrição pertence ao treino curto</strong>; expanda quando
          o básico estiver automático.</span
        ><span data-lang="en"
          >Do not ban arrow keys for your whole workday yet.
          <strong>The constraint belongs in the short drill</strong>; expand it
          when the basics become automatic.</span
        >
      </div>

      <h2 class="section">
        <span class="num">5</span><span data-lang="pt">Recupere sem pistas</span
        ><span data-lang="en">Retrieve without clues</span>
      </h2>
      <div class="grid cols-2">
        <details class="card">
          <summary>
            <span data-lang="pt"
              >Você digitou comandos como texto. O que faz?</span
            ><span data-lang="en"
              >You typed commands as text. What do you do?</span
            >
          </summary>
          <p>
            <span class="kbd">Esc</span>, <span data-lang="pt">depois</span
            ><span data-lang="en">then</span> <span class="kbd">u</span>.
          </p>
        </details>
        <details class="card">
          <summary>
            <span data-lang="pt">Como salvar e sair?</span
            ><span data-lang="en">How do you save and quit?</span>
          </summary>
          <p>
            <span class="kbd">Esc</span> <span class="kbd">:wq</span>
            <span class="kbd">Enter</span>
          </p>
        </details>
        <details class="card">
          <summary>
            <span data-lang="pt">Como apagar uma linha e recuperar?</span
            ><span data-lang="en"
              >How do you delete a line and recover it?</span
            >
          </summary>
          <p>
            <span class="kbd">dd</span> <span data-lang="pt">depois</span
            ><span data-lang="en">then</span> <span class="kbd">u</span>
          </p>
        </details>
        <details class="card">
          <summary>
            <span data-lang="pt">Qual é o treino de hoje?</span
            ><span data-lang="en">What is today's practice?</span>
          </summary>
          <p>
            <span data-lang="pt"
              >Cinco minutos de execução correta, tentando lembrar antes de
              consultar.</span
            ><span data-lang="en"
              >Five minutes of accurate execution, recalling before
              checking.</span
            >
          </p>
        </details>
      </div>

      <footer class="lesson-foot">
        <div>
          <span data-lang="pt">Fonte primária:</span
          ><span data-lang="en">Primary source:</span>
          <a href="https://vimhelp.org/usr_02.txt.html"
            >Vim User Manual · First steps</a
          >
        </div>
        <a class="next-card" href="../reference/vim-core-commands.html"
          ><span class="lbl"
            ><span data-lang="pt">Referência</span
            ><span data-lang="en">Reference</span></span
          >
          <div class="t">
            <span data-lang="pt">Comandos essenciais do Vim →</span
            ><span data-lang="en">Vim core commands →</span>
          </div></a
        >
        <div>
          <span data-lang="pt"
            >Algo não ficou claro? Pergunte ao agente — ele é seu
            professor.</span
          ><span data-lang="en"
            >Anything unclear? Ask the agent—your teacher.</span
          >
          · <a href="../../../index.html">⬡ Hub</a>
        </div>
      </footer>
    </article>
  </Fragment>
</Lesson>
